{
	admin off
	# Railway terminerer TLS foran containeren
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Den gamle WordPress-side brugte to andre stier. Uden disse
	# ville bogmærker, Facebook-opslag og Google-resultater ramme
	# en 404 fra det øjeblik DNS peger herover.
	redir /kalender-og-booking     /kalender/ permanent
	redir /kalender-og-booking/    /kalender/ permanent
	redir /ordenregler-vedtaegter-og-moder   /regler/ permanent
	redir /ordenregler-vedtaegter-og-moder/  /regler/ permanent

	# pæne URL'er: /kalender -> /kalender/index.html
	try_files {path} {path}/index.html {path}/

	file_server

	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server
		}
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}

	# Stylesheet og script hentes med ?v=<hash> stemplet ind under
	# docker build, så de må caches for evigt. Et nyt indhold giver en
	# ny URL, og browseren henter den af sig selv.
	@versioneret path /assets/css/* /assets/js/*
	header @versioneret Cache-Control "public, max-age=31536000, immutable"

	# Billeder og skrifttyper har versionen i filnavnet i forvejen
	# (hero-1131.jpg og så videre), men logoet har et fast navn, så her
	# holder vi en moderat cache. css og js undtages, ellers ville denne
	# regel overskrive den lange cache ovenfor.
	@assets {
		path /assets/*
		not path /assets/css/* /assets/js/*
	}
	header @assets Cache-Control "public, max-age=86400"

	@html path *.html /
	header @html Cache-Control "public, max-age=0, must-revalidate"

	log {
		output stdout
		format console
	}
}
