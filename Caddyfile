{
	admin off
	# Railway terminerer TLS foran containeren
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Den gamle WordPress-side brugte to andre stier. Uden disse
	# ville bogmærker, Facebook-opslag og Google-resultater ramme
	# en 404 fra det øjeblik DNS peger herover.
	redir /kalender-og-booking     /kalender/ permanent
	redir /kalender-og-booking/    /kalender/ permanent
	redir /ordenregler-vedtaegter-og-moder   /regler/ permanent
	redir /ordenregler-vedtaegter-og-moder/  /regler/ permanent

	# pæne URL'er: /kalender -> /kalender/index.html
	try_files {path} {path}/index.html {path}/

	file_server

	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server
		}
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}

	# hashfrie assets: kort cache, så opdateringer slår igennem
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=3600"

	@html path *.html /
	header @html Cache-Control "public, max-age=0, must-revalidate"

	log {
		output stdout
		format console
	}
}
